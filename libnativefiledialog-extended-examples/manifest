depends: * build2 >= 0.18.0
depends: * bpkg >= 0.18.0
depends:
\
glfw ^3.4.0
{
  require
  {
    if ($c.target.class == 'linux')
    {
      config.glfw.build_x11 = true
      config.glfw.build_wayland = true
    }
  }
}
\

# Upstream's test_glfw.c declares WinMain(void) (no arguments), which
# conflicts with the real WinMain prototype pulled in transitively by
# <windows.h> once glfw3native.h includes it. Only MSVC's cl.exe tolerates
# this; MinGW GCC, MinGW Clang, and clang-cl all reject it as a hard
# type-conflict error (verified locally against all three).
#
build-include: windows_10*-msvc_**
build-exclude: windows** ; MinGW GCC, MinGW Clang, and clang-cl reject upstream's WinMain(void) declaration.
