import libs = libnativefiledialog-extended%lib{nfd}

./: exe{test_savedialog}:             c{test_savedialog} $libs
./: exe{test_savedialog_native}:      c{test_savedialog_native} $libs
./: exe{test_savedialog_native_with}: c{test_savedialog_native_with} $libs
